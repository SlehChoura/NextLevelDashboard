# Synchronisation SharePoint (optionnelle) — voir README, section "Synchronisation SharePoint".
# Copiez ce fichier en `.env.local` (ignoré par git) et renseignez les valeurs de votre app
# registration Azure AD. Sans elles, l'application fonctionne normalement, seule la
# synchronisation automatique est désactivée (import manuel du fichier Excel toujours possible).

VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
